<!doctype html>
<html lang="tr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no, viewport-fit=cover">
<title>Pet Life - Widgetable Style</title>
<!-- Modern iOS estetiği için Inter fontu -->
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>
  :root {
    /* Widgetable Pastel & Glassmorphism Renkleri */
    --text-main: #1C1C1E;
    --text-sub: #8E8E93;
    --primary: #FF8F9C; /* Romantik yumuşak pembe/mercan */
    
    /* Buzlu Cam Değerleri */
    --glass-bg: rgba(255, 255, 255, 0.65);
    --glass-border: rgba(255, 255, 255, 0.8);
    --glass-shadow: 0 12px 40px rgba(0, 0, 0, 0.04);
  }

  * { box-sizing: border-box; -webkit-tap-highlight-color: transparent; }

  body, html {
    margin: 0; padding: 0;
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
    background-color: #F4F5F9;
    color: var(--text-main);
    height: 100dvh; overflow: hidden; user-select: none;
  }

  .app-wrapper {
    width: 100%; max-width: 415px; height: 100%;
    margin: 0 auto; display: flex; flex-direction: column;
    position: relative; overflow: hidden;
  }

  /* --- WIDGETABLE ESTETİK ARKA PLAN (Hareketli Pastel Bloblar) --- */
  .bg-blobs {
    position: absolute; top: 0; left: 0; width: 100%; height: 100%;
    z-index: -1; overflow: hidden;
    filter: blur(60px); opacity: 0.55;
  }
  .blob { position: absolute; border-radius: 50%; animation: float 10s infinite ease-in-out alternate; }
  .blob:nth-child(1) { width: 320px; height: 320px; background: #FFD1FF; top: -10%; left: -10%; }
  .blob:nth-child(2) { width: 280px; height: 280px; background: #E0C3FC; bottom: 10%; right: -10%; animation-delay: -3s; }
  .blob:nth-child(3) { width: 220px; height: 220px; background: #8EC5FC; top: 40%; left: 35%; animation-delay: -6s; }

  @keyframes float {
    0% { transform: translate(0, 0) scale(1); }
    100% { transform: translate(30px, 40px) scale(1.1); }
  }

  /* --- HEADER --- */
  .header {
    padding: 50px 24px 20px;
    display: flex; justify-content: space-between; align-items: center;
    z-index: 10;
  }
  .greeting h1 { margin: 0; font-size: 28px; font-weight: 700; letter-spacing: -0.5px; }
  .greeting p { margin: 4px 0 0; font-size: 15px; color: var(--text-sub); font-weight: 500; }
  
  .profile-pic {
    width: 48px; height: 48px; border-radius: 50%;
    background: #FFF; display: grid; place-items: center; font-size: 22px;
    box-shadow: 0 6px 16px rgba(0,0,0,0.06);
  }

  /* --- SCROLL ALANI --- */
  .scroll-area {
    flex: 1; padding: 0 24px 130px;
    overflow-y: auto; scrollbar-width: none; z-index: 10;
  }
  .scroll-area::-webkit-scrollbar { display: none; }

  /* --- WIDGETABLE TARZI PET KARTI (Buzlu Cam) --- */
  .pet-card {
    background: var(--glass-bg);
    backdrop-filter: blur(24px); -webkit-backdrop-filter: blur(24px);
    border: 1.5px solid var(--glass-border);
    border-radius: 36px;
    padding: 30px 20px;
    margin-bottom: 24px;
    box-shadow: var(--glass-shadow);
    display: flex; flex-direction: column; align-items: center; text-align: center;
    cursor: pointer;
    transition: transform 0.2s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  }
  .pet-card:active { transform: scale(0.96); }

  /* Widgetable Dairesel Pet Odak Alanı */
  .pet-circle {
    width: 140px; height: 140px;
    background: linear-gradient(135deg, rgba(255,255,255,0.9), rgba(255,255,255,0.4));
    border-radius: 50%;
    display: grid; place-items: center;
    font-size: 75px;
    box-shadow: inset 0 0 20px rgba(255,255,255,0.6), 0 10px 24px rgba(0,0,0,0.05);
    margin-bottom: 20px;
    position: relative;
  }
  
  /* Seviye rozeti (Hap şeklinde) */
  .level-badge {
    position: absolute; bottom: 0; right: 0;
    background: var(--primary); color: #FFF;
    font-size: 13px; font-weight: 700;
    padding: 6px 14px; border-radius: 20px;
    border: 2.5px solid #FFF;
    box-shadow: 0 4px 12px rgba(255, 143, 156, 0.35);
  }

  .pet-card h3 { margin: 0 0 6px; font-size: 24px; font-weight: 700; letter-spacing: -0.3px; }
  .pet-card p { margin: 0 0 20px; font-size: 15px; color: var(--text-sub); font-weight: 500; }

  /* Etiketler (Tags) */
  .tags { display: flex; gap: 8px; justify-content: center; }
  .tag { 
    background: rgba(0,0,0,0.04); padding: 8px 16px; 
    border-radius: 14px; font-size: 13px; font-weight: 600; color: var(--text-main); 
  }
  .tag.couple { 
    background: rgba(255, 143, 156, 0.12); color: var(--primary); 
  }

  /* --- YÜZEN HAP NAVİGASYON (Dynamic Island / Widgetable Nav) --- */
  .nav-island {
    position: absolute; bottom: 35px; left: 50%; transform: translateX(-50%);
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(255,255,255,0.6);
    display: flex; gap: 8px; padding: 8px;
    border-radius: 100px;
    box-shadow: 0 15px 40px rgba(0,0,0,0.1);
    z-index: 20;
  }
  .nav-btn {
    width: 52px; height: 52px; border-radius: 50%;
    display: grid; place-items: center;
    font-size: 22px; color: var(--text-sub);
    transition: 0.3s cubic-bezier(0.4, 0, 0.2, 1); cursor: pointer;
  }
  .nav-btn.active { background: var(--text-main); color: #FFF; }
  .nav-btn:active { transform: scale(0.9); }

  /* --- BOŞ DURUM --- */
  .empty-state {
    text-align: center; padding: 50px 20px;
    background: rgba(255,255,255,0.4); border-radius: 36px;
    border: 1.5px dashed rgba(0,0,0,0.1); margin-top: 20px;
  }
  .btn-primary {
    display: inline-block; background: var(--text-main); color: #FFF;
    padding: 18px 36px; border-radius: 100px; font-size: 16px; font-weight: 600;
    text-decoration: none; margin-top: 20px;
    box-shadow: 0 10px 24px rgba(0,0,0,0.15); transition: 0.2s;
  }
  .btn-primary:active { transform: scale(0.96); box-shadow: 0 5px 12px rgba(0,0,0,0.1); }

</style>
</head>
<body>

<div class="app-wrapper">
  
  <!-- Arka Plan Estetik Bloblar -->
  <div class="bg-blobs">
    <div class="blob"></div>
    <div class="blob"></div>
    <div class="blob"></div>
  </div>

  <div class="header">
    <div class="greeting">
      <h1>Hoş geldin,</h1>
      <p><%= player %></p>
    </div>
    <div class="profile-pic">🧑‍🚀</div>
  </div>

  <div class="scroll-area">
    <% if (worlds && worlds.length > 0) { %>
      <% worlds.forEach(function(world) { %>
        <!-- Widgetable Tarzı Geniş ve Yuvarlak Kart -->
        <div class="pet-card" onclick="window.location.href='/pet/<%= world.id %>'">
          
          <div class="pet-circle">
            <%= (world.safePet.type === 'dog') ? '🐶' : (world.safePet.type === 'bunny') ? '🐰' : '🐱' %>
            <div class="level-badge">Lv. <%= world.safePet.level %></div>
          </div>
          
          <h3><%= world.safePet.name %></h3>
          <p>🏡 <%= world.name %></p>
          
          <!-- Özellik Etiketleri (Widgetable Besties hissiyatı için) -->
          <div class="tags">
            <div class="tag">Mutlu ✨</div>
            <% if(world.members && world.members.length > 1) { %>
              <div class="tag couple">Ortak Pet 💖</div>
            <% } else { %>
              <div class="tag">Tek Başına</div>
            <% } %>
          </div>

        </div>
      <% }); %>
    <% } else { %>
      <div class="empty-state">
        <span style="font-size: 56px;">🥚</span>
        <h3 style="font-size: 22px; font-weight: 700; margin: 16px 0 8px;">Yumurtan hazır</h3>
        <p style="color: var(--text-sub); font-weight: 500; font-size: 15px; margin: 0;">Yeni bir dost sahiplen ve hemen bakmaya başla.</p>
        <a href="/create" class="btn-primary">Yumurtayı Kır</a>
      </div>
    <% } %>
  </div>

  <!-- Yüzen Hap Menü (Dynamic Island tarzı) -->
  <div class="nav-island">
    <div class="nav-btn active">🏡</div>
    <div class="nav-btn">🎒</div>
    <div class="nav-btn">💌</div>
    <div class="nav-btn">⚙️</div>
  </div>

</div>

</body>
</html>