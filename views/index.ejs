<!doctype html>
<html lang="tr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no, viewport-fit=cover">
<title>Pet Life</title>
<link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@600;700;800&display=swap" rel="stylesheet">
<style>
  :root {
    /* Gerçek Oyun Renk Paleti */
    --game-bg: #E8F1F5;
    --card-bg: #FFFFFF;
    --text-dark: #303952;
    --text-muted: #828EA6;
    
    /* Canlı Aksanlar */
    --accent-blue: #45AAF2;
    --accent-blue-shadow: #2D98DA;
    --accent-green: #26DE81;
    --accent-green-shadow: #20BF6B;
    --accent-orange: #FA8231;
    --accent-orange-shadow: #EB3B5A;
  }

  * { box-sizing: border-box; -webkit-tap-highlight-color: transparent; }

  body {
    margin: 0;
    font-family: 'Fredoka', sans-serif;
    background-color: var(--game-bg);
    /* Hafif noktalı oyun zemini (Polka dot) */
    background-image: radial-gradient(#D1D8E0 2px, transparent 2px);
    background-size: 24px 24px;
    color: var(--text-dark);
    display: flex; justify-content: center;
    height: 100dvh; overflow: hidden; user-select: none;
  }

  .app-container {
    width: 100%; max-width: 415px; height: 100%;
    display: flex; flex-direction: column; position: relative;
  }

  /* --- ÜST BİLGİ (HEADER) --- */
  .header {
    padding: 30px 20px 20px;
    display: flex; justify-content: space-between; align-items: center;
    background: linear-gradient(180deg, rgba(232,241,245,1) 60%, rgba(232,241,245,0) 100%);
    z-index: 10;
  }
  .header-left h1 { margin: 0; font-size: 28px; font-weight: 800; letter-spacing: -0.5px; color: var(--accent-blue); text-shadow: 0 2px 0 var(--accent-blue-shadow); }
  .header-left p { margin: 4px 0 0; font-size: 15px; font-weight: 700; color: var(--text-muted); }
  
  .avatar-frame {
    width: 55px; height: 55px;
    background: var(--accent-orange);
    border-radius: 18px;
    display: grid; place-items: center; font-size: 26px;
    border: 4px solid #FFF;
    box-shadow: 0 6px 0 var(--accent-orange-shadow), 0 10px 15px rgba(250,130,49,0.3);
  }

  /* --- ORTA ALAN (KAYDIRILABİLİR PET LİSTESİ) --- */
  .scroll-area {
    flex: 1; padding: 10px 20px 110px;
    overflow-y: auto; scrollbar-width: none;
  }
  .scroll-area::-webkit-scrollbar { display: none; }

  .section-badge {
    display: inline-block;
    background: var(--card-bg);
    padding: 6px 16px; border-radius: 20px;
    font-size: 14px; font-weight: 800; color: var(--text-muted);
    border: 3px solid #E1E8ED; box-shadow: 0 4px 0 #E1E8ED;
    margin-bottom: 20px;
  }

  /* --- GERÇEK OYUN KARTLARI (3D TOK HİSSİYAT) --- */
  .pet-card {
    background: var(--card-bg);
    border: 4px solid #D1D8E0;
    border-radius: 28px;
    padding: 16px;
    display: flex; align-items: center; gap: 16px;
    margin-bottom: 20px;
    cursor: pointer;
    box-shadow: 0 8px 0 #D1D8E0, 0 15px 20px rgba(0,0,0,0.05);
    transition: transform 0.1s cubic-bezier(0.4, 0, 0.2, 1), box-shadow 0.1s;
    animation: popIn 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275) backwards;
  }
  
  .pet-card:active {
    transform: translateY(8px) scale(0.98);
    box-shadow: 0 0 0 transparent, 0 5px 10px rgba(0,0,0,0.05);
  }

  .pet-icon-wrapper {
    width: 75px; height: 75px;
    background: linear-gradient(135deg, var(--accent-green), var(--accent-green-shadow));
    border-radius: 22px;
    display: grid; place-items: center; font-size: 40px;
    border: 4px solid #FFF;
    box-shadow: 0 6px 0 var(--accent-green-shadow);
    position: relative;
  }
  /* Parlama efekti */
  .pet-icon-wrapper::after {
    content: ''; position: absolute; top: 4px; left: 8px; right: 8px; height: 12px;
    background: rgba(255,255,255,0.3); border-radius: 10px;
  }

  .pet-info { flex: 1; }
  .pet-name { font-size: 22px; font-weight: 800; margin: 0 0 4px 0; color: var(--text-dark); }
  .pet-meta { font-size: 14px; font-weight: 700; color: var(--text-muted); margin: 0; display: flex; align-items: center; gap: 4px; }

  .level-badge {
    background: var(--accent-blue); color: #FFF;
    padding: 6px 14px; border-radius: 16px;
    font-size: 15px; font-weight: 800;
    border: 3px solid #FFF;
    box-shadow: 0 4px 0 var(--accent-blue-shadow);
  }

  /* --- YÜZEN ALT NAVİGASYON (Floating Game Nav) --- */
  .bottom-nav-container {
    position: absolute; bottom: 25px; left: 20px; right: 20px;
    background: var(--card-bg);
    border: 4px solid #D1D8E0; border-radius: 30px;
    display: flex; justify-content: space-around; padding: 12px 10px;
    box-shadow: 0 8px 0 #D1D8E0, 0 20px 30px rgba(0,0,0,0.1);
  }
  
  .nav-btn {
    display: flex; flex-direction: column; align-items: center; gap: 4px;
    color: var(--text-muted); font-size: 13px; font-weight: 800;
    transition: 0.2s; cursor: pointer; padding: 5px 15px; border-radius: 20px;
  }
  .nav-btn.active { background: var(--game-bg); color: var(--accent-blue); }
  .nav-btn span { font-size: 26px; filter: grayscale(1); transition: 0.2s; }
  .nav-btn.active span { filter: grayscale(0); transform: translateY(-3px); }

  /* Animasyonlar */
  @keyframes popIn {
    0% { transform: scale(0.8) translateY(20px); opacity: 0; }
    100% { transform: scale(1) translateY(0); opacity: 1; }
  }

  /* Boş Durum (Empty State) - Oyun Kutusu Tarzı */
  .empty-box {
    background: var(--card-bg); border: 4px dashed #D1D8E0; border-radius: 28px;
    text-align: center; padding: 40px 20px; margin-top: 20px;
  }
  .btn-game {
    display: inline-block; background: var(--accent-green); color: #FFF;
    font-size: 18px; font-weight: 800; text-decoration: none;
    padding: 16px 30px; border-radius: 22px; border: 4px solid #FFF;
    box-shadow: 0 6px 0 var(--accent-green-shadow), 0 10px 15px rgba(38, 222, 129, 0.3);
    margin-top: 20px; transition: transform 0.1s;
  }
  .btn-game:active { transform: translateY(6px); box-shadow: 0 0 0 transparent; }

</style>
</head>
<body>

<div class="app-container">
  
  <div class="header">
    <div class="header-left">
      <h1>Pet Life</h1>
      <p>Oyuncu: <%= player %></p>
    </div>
    <div class="avatar-frame">🧑‍🚀</div>
  </div>

  <div class="scroll-area">
    <div class="section-badge">Senin Dünyaların (<%= worlds.length %>)</div>

    <% if (worlds && worlds.length > 0) { %>
      <% worlds.forEach(function(world, index) { %>
        <!-- Animasyon gecikmesi ile kartların sırayla tatlı şekilde düşmesini sağlıyoruz -->
        <div class="pet-card" onclick="window.location.href='/pet/<%= world.id %>'" style="animation-delay: <%= index * 0.1 %>s">
          <div class="pet-icon-wrapper">
            <%= (world.safePet.type === 'dog') ? '🐶' : (world.safePet.type === 'bunny') ? '🐰' : '🐱' %>
          </div>
          <div class="pet-info">
            <h3 class="pet-name"><%= world.safePet.name %></h3>
            <p class="pet-meta">🏡 <%= world.name %></p>
          </div>
          <div class="level-badge">
            Lv. <%= world.safePet.level %>
          </div>
        </div>
      <% }); %>
    <% } else { %>
      <div class="empty-box">
        <span style="font-size: 50px;">🐾</span>
        <h3 style="font-size: 22px; margin: 10px 0;">Evcil Hayvanın Yok</h3>
        <p style="color: var(--text-muted); font-weight: 700;">Hemen kendine bir dost edin.</p>
        <a href="/create" class="btn-game">Yeni Pet Sahiplen</a>
      </div>
    <% } %>
  </div>

  <div class="bottom-nav-container">
    <div class="nav-btn active"><span>🏠</span> Ev</div>
    <div class="nav-btn"><span>🎒</span> Çanta</div>
    <div class="nav-btn"><span>👥</span> Sosyal</div>
    <div class="nav-btn"><span>👤</span> Profil</div>
  </div>

</div>

</body>
</html>