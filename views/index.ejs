<!doctype html>
<html lang="tr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, user-scalable=no">
<title>Mellow Pet</title>
<link href="https://fonts.googleapis.com/css2?family=Nunito:wght@700;800;900&display=swap" rel="stylesheet">
<style>
  :root {
    --bg: #F0F4F8;
    --primary: #FF8B94;
    --primary-shadow: #D8606B;
    --ui-bg: #FFFFFF;
    --text: #2D3436;
  }
  body { margin: 0; font-family: 'Nunito', sans-serif; background: var(--bg); color: var(--text); display: flex; justify-content: center; min-height: 100vh; user-select: none; }
  .app-container { width: 100%; max-width: 400px; background: var(--bg); display: flex; flex-direction: column; overflow: hidden; position: relative; }
  .stage { flex: 1; background: linear-gradient(180deg, #87CEEB 0%, #E0F6FF 60%, #A8E6CF 60%, #7DC6AB 100%); position: relative; display: flex; flex-direction: column; align-items: center; justify-content: flex-end; padding-bottom: 40px; border-radius: 0 0 40px 40px; box-shadow: 0 10px 20px rgba(0,0,0,0.1); }
  
  .header-info { position: absolute; top: 60px; text-align: center; width: 100%; font-weight: 800; font-size: 22px; color: #2D3436; }
  .header-info small { display: block; font-size: 13px; opacity: 0.7; }
  
  .pet-sprite { font-size: 100px; animation: breathe 2s infinite ease-in-out; filter: drop-shadow(0 15px 10px rgba(0,0,0,0.2)); }
  @keyframes breathe { 0%, 100% { transform: scale(1) translateY(0); } 50% { transform: scale(1.05) translateY(-5px); } }
  
  .stats { position: absolute; top: 20px; left: 20px; right: 20px; display: flex; gap: 10px; }
  .stat-bar { flex: 1; height: 24px; background: rgba(255,255,255,0.5); border-radius: 20px; border: 3px solid #FFF; overflow: hidden; position: relative; }
  .fill { height: 100%; border-radius: 20px; transition: width 0.3s cubic-bezier(0.4, 0, 0.2, 1); position: relative; }
  .fill::after { content: ''; position: absolute; top: 2px; left: 5px; right: 5px; height: 6px; background: rgba(255,255,255,0.4); border-radius: 10px; }

  .action-panel { padding: 30px 20px; display: grid; grid-template-columns: repeat(3, 1fr); gap: 15px; }
  .btn { background: var(--ui-bg); border: 3px solid #E1E8ED; border-radius: 20px; padding: 15px 10px; font: inherit; font-size: 16px; font-weight: 800; color: var(--text); cursor: pointer; box-shadow: 0 6px 0 #E1E8ED; transition: all 0.1s; display: flex; flex-direction: column; align-items: center; gap: 5px; }
  .btn span { font-size: 28px; }
  .btn:active { transform: translateY(6px); box-shadow: 0 0 0 transparent; }
  .btn.primary { background: var(--primary); border-color: var(--primary-shadow); color: white; box-shadow: 0 6px 0 var(--primary-shadow); }
</style>
</head>
<body>

<div class="app-container">
  <div class="stage">
    <div class="stats">
      <div class="stat-bar"><div class="fill" style="width: <%= pet.stats.hunger %>%; background: #FF9A8B;"></div></div>
      <div class="stat-bar"><div class="fill" style="width: <%= pet.stats.energy %>%; background: #A8E6CF;"></div></div>
      <div class="stat-bar"><div class="fill" style="width: <%= pet.stats.happiness %>%; background: #FFD3B6;"></div></div>
    </div>
    
    <div class="header-info">
      <%= pet.name %> (Lv. <%= pet.level %>)
      <small>Sahibi: <%= player %></small>
    </div>
    <div class="pet-sprite">🦊</div> 
  </div>

  <div class="action-panel">
    <button class="btn"><span>🍖</span> Besle</button>
    <button class="btn primary"><span>🎾</span> Oyna</button>
    <button class="btn"><span>💤</span> Uyut</button>
  </div>
</div>

</body>
</html>